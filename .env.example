# Copy to .env and fill in. .env is gitignored.

# Required — the Red, Blue, and Target agents all call Claude.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for all agent calls. Opus 4.8 is the default and most capable.
AGENT_MODEL=claude-opus-4-8

# Pomerium MCP gateway. For laptop mode the tool server is called directly
# unless USE_POMERIUM=1, in which case tool calls route through this URL.
USE_POMERIUM=0
POMERIUM_URL=http://127.0.0.1:18081/mcp

# Where the tool server listens (used by target_agent + pomerium route).
TOOL_SERVER_URL=http://localhost:8080
TOOL_SERVER_ADMIN_URL=http://127.0.0.1:18080

# Reserved for a later service-account / OIDC-backed Pomerium path.
POMERIUM_JWT_SECRET=dev-only-not-a-real-secret

# Storage backend: "json" (default, files under storage/data/) or "sqlite".
STORAGE_BACKEND=json
