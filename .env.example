# Copy to .env and fill in. .env is gitignored.

# Required — the Red, Blue, and Target agents all call Claude.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for all agent calls on the Anthropic API. Opus 4.8 is the default.
AGENT_MODEL=claude-opus-4-8

# LLM backend for DEMO_MODE=live: "anthropic" (default, uses ANTHROPIC_API_KEY) or
# "bedrock" (Amazon Bedrock, uses the ambient AWS creds + AWS_REGION below).
LLM_BACKEND=anthropic

# Bedrock settings (only used when LLM_BACKEND=bedrock). BEDROCK_MODEL_ID must be an
# inference-profile id (the bare anthropic.claude-... id is on-demand only and 400s).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# DEMO_MODE: "deterministic" (no LLM, reproducible) or "live" (calls the LLM backend).
DEMO_MODE=deterministic

# Pomerium MCP gateway. For laptop mode the tool server is called directly
# unless USE_POMERIUM=1, in which case tool calls route through this URL.
USE_POMERIUM=0
POMERIUM_URL=http://127.0.0.1:18081/mcp

# Where the tool server listens (used by target_agent + pomerium route).
TOOL_SERVER_URL=http://localhost:8080
TOOL_SERVER_ADMIN_URL=http://127.0.0.1:18080

# Reserved for a later service-account / OIDC-backed Pomerium path.
POMERIUM_JWT_SECRET=dev-only-not-a-real-secret

# Persistence backend: "json" (default, local files under storage/data/) or
# "dynamodb" (AWS DynamoDB + S3, using the ambient AWS creds + AWS_REGION above).
STORAGE_BACKEND=json

# DynamoDB/S3 targets (only used when STORAGE_BACKEND=dynamodb). Defaults match the
# Terraform-provisioned infra; the bucket auto-derives from your account id if unset.
DDB_ATTACKS_TABLE=AttackStrategies
DDB_DEFENDERS_TABLE=DefenderVersions
# S3_TRANSCRIPTS_BUCKET=agent-immune-ci-transcripts-<your-account-id>
